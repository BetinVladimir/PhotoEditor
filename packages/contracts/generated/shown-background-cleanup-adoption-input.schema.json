{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/shown-background-cleanup-adoption-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen copy task inputs; SQL must prove human decision and receipt origin.",
  "properties": {
    "approved_edit": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "child_run_id": {
      "format": "uuid",
      "title": "Child Run Id",
      "type": "string"
    },
    "device_profile_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Device Profile Sha",
      "type": "string"
    },
    "model_lock_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Lock Sha",
      "type": "string"
    },
    "numerical_evidence": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "pixels": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "presentation": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "preview_attempt": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Preview Attempt",
      "type": "integer"
    },
    "preview_fence": {
      "oneOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "description": "Canonical decimal int64 strictly above 9007199254740991 and at most 9223372036854775807.",
          "pattern": "^(?:9(?:0(?:0(?:7(?:199(?:2(?:5(?:4(?:7(?:4(?:099[2-9]|[1-8][0-9]{3}|9[0-9]{3})|[5-8][0-9]{4}|9[0-9]{4})|8[0-9]{5}|9[0-9]{5})|[5-8][0-9]{6}|9[0-9]{6})|[6-8][0-9]{7}|9[0-9]{7})|[3-8][0-9]{8}|9[0-9]{8})|[2-8][0-9]{11}|9[0-9]{11})|8[0-9]{12}|9[0-9]{12})|[1-8][0-9]{13}|9[0-9]{13})|[1-8][0-9]{14}|9[0-9]{14})|[1-9][0-9]{16,17}|(?:1[0-9]{18}|[2-8][0-9]{18}|9(?:0[0-9]{17}|1[0-9]{17}|2(?:0[0-9]{16}|1[0-9]{16}|2(?:0[0-9]{15}|[1-2][0-9]{15}|3(?:0[0-9]{14}|[1-2][0-9]{14}|3(?:0[0-9]{13}|[1-6][0-9]{13}|7(?:0[0-9]{12}|1[0-9]{12}|20(?:0[0-9]{10}|[1-2][0-9]{10}|3(?:0[0-9]{9}|[1-5][0-9]{9}|6(?:0[0-9]{8}|[1-7][0-9]{8}|8(?:0[0-9]{7}|[1-4][0-9]{7}|5(?:0[0-9]{6}|[1-3][0-9]{6}|4(?:0[0-9]{5}|[1-6][0-9]{5}|7(?:0[0-9]{4}|[1-6][0-9]{4}|7(?:0[0-9]{3}|[1-4][0-9]{3}|5(?:0[0-9]{2}|[1-7][0-9]{2}|80[0-7])))))))))))))))))$",
          "type": "string"
        }
      ],
      "title": "Preview Fence"
    },
    "preview_result_id": {
      "format": "uuid",
      "title": "Preview Result Id",
      "type": "string"
    },
    "preview_run_id": {
      "format": "uuid",
      "title": "Preview Run Id",
      "type": "string"
    },
    "preview_task_id": {
      "format": "uuid",
      "title": "Preview Task Id",
      "type": "string"
    },
    "runtime_lock_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Lock Sha",
      "type": "string"
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "working_image": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "child_run_id",
    "target_id",
    "approved_edit",
    "preview_run_id",
    "preview_task_id",
    "preview_result_id",
    "preview_attempt",
    "preview_fence",
    "presentation",
    "numerical_evidence",
    "working_image",
    "pixels",
    "model_lock_sha",
    "runtime_lock_sha",
    "device_profile_sha"
  ],
  "title": "ShownBackgroundCleanupAdoptionInput",
  "type": "object"
}
