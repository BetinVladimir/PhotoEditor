{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "orientation": {
          "const": 1,
          "title": "Orientation",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "space_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Space Id",
          "type": "string"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "orientation",
        "space_id",
        "source_sha256"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "ColorFitParams": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "alignment": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "before": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "geometry_mode": {
          "const": "similarity_only",
          "default": "similarity_only",
          "title": "Geometry Mode",
          "type": "string"
        },
        "ignore": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "local_requested": {
          "default": true,
          "title": "Local Requested",
          "type": "boolean"
        },
        "pair_id": {
          "format": "uuid",
          "title": "Pair Id",
          "type": "string"
        },
        "person": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "samples": {
          "const": 65536,
          "default": 65536,
          "title": "Samples",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "pair_id",
        "before",
        "after",
        "alignment"
      ],
      "title": "ColorFitParams",
      "type": "object"
    },
    "CropTransform": {
      "additionalProperties": false,
      "properties": {
        "crop_rect": {
          "$ref": "#/$defs/Rect"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "crop",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "crop_rect"
      ],
      "title": "CropTransform",
      "type": "object"
    },
    "DenseWarpTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "inverse_field": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "dense_warp",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "inverse_field"
      ],
      "title": "DenseWarpTransform",
      "type": "object"
    },
    "Disabled": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": false,
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "Disabled",
      "type": "object"
    },
    "FitCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "holdout_loss": {
          "minimum": 0,
          "title": "Holdout Loss",
          "type": "number"
        },
        "stage": {
          "enum": [
            "identity",
            "parameters",
            "residual",
            "local"
          ],
          "title": "Stage",
          "type": "string"
        },
        "step": {
          "maximum": 600,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "stage",
        "step",
        "holdout_loss"
      ],
      "title": "FitCheckpoint",
      "type": "object"
    },
    "FitSamplingEvidence": {
      "additionalProperties": false,
      "properties": {
        "holdout_blocks": {
          "items": {
            "maximum": 63,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 63,
          "minItems": 1,
          "title": "Holdout Blocks",
          "type": "array"
        },
        "holdout_count": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Holdout Count",
          "type": "integer"
        },
        "holdout_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Holdout Digest",
          "type": "string"
        },
        "holdout_seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Holdout Seed",
          "type": "integer"
        },
        "split_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Split Digest",
          "type": "string"
        },
        "train_count": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Train Count",
          "type": "integer"
        },
        "train_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Train Digest",
          "type": "string"
        },
        "train_seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Train Seed",
          "type": "integer"
        },
        "warp_version": {
          "const": "linear_bilinear_global_v1",
          "title": "Warp Version",
          "type": "string"
        }
      },
      "required": [
        "split_digest",
        "holdout_blocks",
        "train_digest",
        "holdout_digest",
        "train_seed",
        "holdout_seed",
        "warp_version",
        "train_count",
        "holdout_count"
      ],
      "title": "FitSamplingEvidence",
      "type": "object"
    },
    "GlobalColor": {
      "additionalProperties": false,
      "properties": {
        "gains_rgb": {
          "items": {
            "maximum": 4,
            "minimum": 0.25,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Gains Rgb",
          "type": "array"
        },
        "master_curve": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Master Curve",
          "type": "array"
        },
        "residual_lut": {
          "$ref": "#/$defs/LUT"
        },
        "rgb_curves": {
          "items": {
            "items": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 7,
            "minItems": 7,
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Rgb Curves",
          "type": "array"
        },
        "saturation": {
          "maximum": 2,
          "minimum": 0,
          "title": "Saturation",
          "type": "number"
        }
      },
      "required": [
        "gains_rgb",
        "master_curve",
        "rgb_curves",
        "saturation",
        "residual_lut"
      ],
      "title": "GlobalColor",
      "type": "object"
    },
    "LUT": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "items": {
            "type": "number"
          },
          "title": "Domain",
          "type": "array"
        },
        "encoding": {
          "enum": [
            "dense",
            "constant"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "kind": {
          "enum": [
            "residual",
            "absolute"
          ],
          "title": "Kind",
          "type": "string"
        },
        "order": {
          "const": "RGB_C",
          "default": "RGB_C",
          "title": "Order",
          "type": "string"
        },
        "size": {
          "enum": [
            17,
            33,
            65
          ],
          "title": "Size",
          "type": "integer"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "size",
        "encoding",
        "values"
      ],
      "title": "LUT",
      "type": "object"
    },
    "LocalColor": {
      "additionalProperties": false,
      "properties": {
        "background_ev": {
          "maximum": 1,
          "minimum": -1,
          "title": "Background Ev",
          "type": "number"
        },
        "background_saturation": {
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Background Saturation",
          "type": "number"
        },
        "enabled": {
          "const": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "mask_policy_id": {
          "const": "person_guided_v1",
          "title": "Mask Policy Id",
          "type": "string"
        },
        "person_ev": {
          "maximum": 1,
          "minimum": -1,
          "title": "Person Ev",
          "type": "number"
        },
        "person_saturation": {
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Person Saturation",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "person_ev",
        "background_ev",
        "person_saturation",
        "background_saturation",
        "mask_policy_id"
      ],
      "title": "LocalColor",
      "type": "object"
    },
    "MaskRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "model_lock_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Lock Id"
        },
        "object_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "selector": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Selector",
          "type": "string"
        },
        "transform_chain": {
          "$ref": "#/$defs/TransformChain"
        }
      },
      "required": [
        "artifact",
        "canvas",
        "transform_chain",
        "selector",
        "confidence",
        "model_lock_id",
        "protected"
      ],
      "title": "MaskRef",
      "type": "object"
    },
    "MatrixTransform": {
      "additionalProperties": false,
      "properties": {
        "forward_matrix": {
          "items": {
            "maximum": 1000000000000.0,
            "minimum": -1000000000000.0,
            "type": "number"
          },
          "maxItems": 9,
          "minItems": 9,
          "title": "Forward Matrix",
          "type": "array"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "matrix",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "forward_matrix"
      ],
      "title": "MatrixTransform",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Rect",
      "type": "object"
    },
    "ResizeTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "resize",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "title": "Pixel Centers",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "pixel_centers"
      ],
      "title": "ResizeTransform",
      "type": "object"
    },
    "TransformChain": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "crop": "#/$defs/CropTransform",
                "dense_warp": "#/$defs/DenseWarpTransform",
                "matrix": "#/$defs/MatrixTransform",
                "resize": "#/$defs/ResizeTransform"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MatrixTransform"
              },
              {
                "$ref": "#/$defs/DenseWarpTransform"
              },
              {
                "$ref": "#/$defs/CropTransform"
              },
              {
                "$ref": "#/$defs/ResizeTransform"
              }
            ]
          },
          "maxItems": 128,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps",
        "hash"
      ],
      "title": "TransformChain",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/color-fit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "enum": [
        "cpu",
        "mps",
        "cuda"
      ],
      "title": "Backend",
      "type": "string"
    },
    "global_color": {
      "$ref": "#/$defs/GlobalColor"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/FitCheckpoint"
      },
      "maxItems": 1500,
      "minItems": 1,
      "title": "History",
      "type": "array"
    },
    "holdout_loss": {
      "minimum": 0,
      "title": "Holdout Loss",
      "type": "number"
    },
    "initialization_index": {
      "maximum": 2,
      "minimum": 0,
      "title": "Initialization Index",
      "type": "integer"
    },
    "local": {
      "discriminator": {
        "mapping": {
          "False": "#/$defs/Disabled",
          "True": "#/$defs/LocalColor"
        },
        "propertyName": "enabled"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Disabled"
        },
        {
          "$ref": "#/$defs/LocalColor"
        }
      ],
      "title": "Local"
    },
    "median_delta_e": {
      "minimum": 0,
      "title": "Median Delta E",
      "type": "number"
    },
    "optimizer_version": {
      "const": "color_fit_adam_v1",
      "title": "Optimizer Version",
      "type": "string"
    },
    "p95_delta_e": {
      "minimum": 0,
      "title": "P95 Delta E",
      "type": "number"
    },
    "params": {
      "$ref": "#/$defs/ColorFitParams"
    },
    "sampling": {
      "$ref": "#/$defs/FitSamplingEvidence"
    },
    "transfer_confidence": {
      "const": "unvalidated",
      "default": "unvalidated",
      "title": "Transfer Confidence",
      "type": "string"
    },
    "warnings": {
      "items": {
        "enum": [
          "alignment_review_required",
          "local_mask_unavailable",
          "local_mask_unreliable"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "params",
    "global_color",
    "local",
    "holdout_loss",
    "median_delta_e",
    "p95_delta_e",
    "initialization_index",
    "optimizer_version",
    "backend",
    "sampling",
    "history",
    "warnings"
  ],
  "title": "ColorFit",
  "type": "object"
}
