{
  "$defs": {
    "GPSMetadata": {
      "additionalProperties": false,
      "properties": {
        "altitude_m": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": -1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude M"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "GPSMetadata",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/metadata-document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "camera_make": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Camera Make"
    },
    "camera_model": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Camera Model"
    },
    "copyright": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Copyright"
    },
    "datetime_original": {
      "anyOf": [
        {
          "pattern": "^\\d{4}:\\d{2}:\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Datetime Original"
    },
    "gps": {
      "anyOf": [
        {
          "$ref": "#/$defs/GPSMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lens": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lens"
    }
  },
  "title": "MetadataDocument",
  "type": "object"
}
