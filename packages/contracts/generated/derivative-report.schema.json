{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/derivative-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied": {
      "title": "Applied",
      "type": "boolean"
    },
    "height": {
      "maximum": 200000,
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "image": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "max_channel_delta": {
      "maximum": 1,
      "minimum": 0,
      "title": "Max Channel Delta",
      "type": "number"
    },
    "operation": {
      "enum": [
        "resize",
        "sharpen",
        "watermark"
      ],
      "title": "Operation",
      "type": "string"
    },
    "warnings": {
      "items": {
        "enum": [
          "no_resize_required",
          "zero_strength",
          "zero_opacity"
        ],
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "width": {
      "maximum": 200000,
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "image",
    "operation",
    "applied",
    "width",
    "height",
    "max_channel_delta",
    "warnings"
  ],
  "title": "DerivativeReport",
  "type": "object"
}
