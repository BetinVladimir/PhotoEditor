{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/person-params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "guided_tile": {
      "default": 512,
      "enum": [
        256,
        512,
        1024
      ],
      "title": "Guided Tile",
      "type": "integer"
    },
    "image": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "long_side": {
      "const": 768,
      "default": 768,
      "title": "Long Side",
      "type": "integer"
    },
    "model_id": {
      "const": "lraspp_mobilenet_v3_large",
      "default": "lraspp_mobilenet_v3_large",
      "title": "Model Id",
      "type": "string"
    },
    "model_lock_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Lock Id",
      "type": "string"
    },
    "preprocessing_id": {
      "const": "person_guided_v1",
      "default": "person_guided_v1",
      "title": "Preprocessing Id",
      "type": "string"
    }
  },
  "required": [
    "image",
    "model_lock_id"
  ],
  "title": "PersonParams",
  "type": "object"
}
