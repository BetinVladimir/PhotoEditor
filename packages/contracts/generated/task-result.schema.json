{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "TaskError": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Args",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "diagnostic_artifact_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostic Artifact Id"
        },
        "message_key": {
          "title": "Message Key",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "message_key",
        "args"
      ],
      "title": "TaskError",
      "type": "object"
    },
    "TaskMetrics": {
      "additionalProperties": false,
      "properties": {
        "bytes_read": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Read"
        },
        "bytes_written": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Written"
        },
        "done": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Done"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "peak_device_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Device Bytes"
        },
        "peak_memory_bytes": {
          "minimum": 0,
          "title": "Peak Memory Bytes",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "duration_ms",
        "peak_memory_bytes"
      ],
      "title": "TaskMetrics",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/task-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskError"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "fencing_token": {
      "minimum": 1,
      "title": "Fencing Token",
      "type": "integer"
    },
    "metrics": {
      "$ref": "#/$defs/TaskMetrics"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 128,
      "title": "Outputs",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "task.succeeded",
        "task.failed",
        "task.cancelled",
        "task.progress"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "type",
    "tenant_id",
    "run_id",
    "task_id",
    "attempt",
    "fencing_token",
    "outputs",
    "metrics",
    "error"
  ],
  "title": "TaskResult",
  "type": "object"
}
