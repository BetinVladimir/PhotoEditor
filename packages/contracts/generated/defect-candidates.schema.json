{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "orientation": {
          "const": 1,
          "title": "Orientation",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "space_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Space Id",
          "type": "string"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "orientation",
        "space_id",
        "source_sha256"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "CropTransform": {
      "additionalProperties": false,
      "properties": {
        "crop_rect": {
          "$ref": "#/$defs/Rect"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "crop",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "crop_rect"
      ],
      "title": "CropTransform",
      "type": "object"
    },
    "DefectCandidate": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "decision": {
          "const": "pending",
          "default": "pending",
          "title": "Decision",
          "type": "string"
        },
        "diameter": {
          "exclusiveMinimum": 0,
          "maximum": 200000000,
          "title": "Diameter",
          "type": "number"
        },
        "id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Label",
          "type": "integer"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "bbox",
        "diameter",
        "score"
      ],
      "title": "DefectCandidate",
      "type": "object"
    },
    "DenseWarpTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "inverse_field": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "dense_warp",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "inverse_field"
      ],
      "title": "DenseWarpTransform",
      "type": "object"
    },
    "MatrixTransform": {
      "additionalProperties": false,
      "properties": {
        "forward_matrix": {
          "items": {
            "maximum": 1000000000000.0,
            "minimum": -1000000000000.0,
            "type": "number"
          },
          "maxItems": 9,
          "minItems": 9,
          "title": "Forward Matrix",
          "type": "array"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "matrix",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "forward_matrix"
      ],
      "title": "MatrixTransform",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Rect",
      "type": "object"
    },
    "ResizeTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "resize",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "title": "Pixel Centers",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "pixel_centers"
      ],
      "title": "ResizeTransform",
      "type": "object"
    },
    "TransformChain": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "crop": "#/$defs/CropTransform",
                "dense_warp": "#/$defs/DenseWarpTransform",
                "matrix": "#/$defs/MatrixTransform",
                "resize": "#/$defs/ResizeTransform"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MatrixTransform"
              },
              {
                "$ref": "#/$defs/DenseWarpTransform"
              },
              {
                "$ref": "#/$defs/CropTransform"
              },
              {
                "$ref": "#/$defs/ResizeTransform"
              }
            ]
          },
          "maxItems": 128,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps",
        "hash"
      ],
      "title": "TransformChain",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/defect-candidates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/DefectCandidate"
      },
      "maxItems": 4096,
      "title": "Candidates",
      "type": "array"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "image": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "label_map": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_pixels": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "transform_chain": {
      "$ref": "#/$defs/TransformChain"
    },
    "version": {
      "const": "defect_candidates_v1",
      "default": "defect_candidates_v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "image",
    "source_pixels",
    "label_map",
    "canvas",
    "transform_chain",
    "candidates"
  ],
  "title": "DefectCandidates",
  "type": "object"
}
