{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "orientation": {
          "const": 1,
          "title": "Orientation",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "space_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Space Id",
          "type": "string"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "orientation",
        "space_id",
        "source_sha256"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "CropTransform": {
      "additionalProperties": false,
      "properties": {
        "crop_rect": {
          "$ref": "#/$defs/Rect"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "crop",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "crop_rect"
      ],
      "title": "CropTransform",
      "type": "object"
    },
    "DenseWarpTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "inverse_field": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "dense_warp",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "inverse_field"
      ],
      "title": "DenseWarpTransform",
      "type": "object"
    },
    "MaskRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "model_lock_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Lock Id"
        },
        "object_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "selector": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Selector",
          "type": "string"
        },
        "transform_chain": {
          "$ref": "#/$defs/TransformChain"
        }
      },
      "required": [
        "artifact",
        "canvas",
        "transform_chain",
        "selector",
        "confidence",
        "model_lock_id",
        "protected"
      ],
      "title": "MaskRef",
      "type": "object"
    },
    "MatrixTransform": {
      "additionalProperties": false,
      "properties": {
        "forward_matrix": {
          "items": {
            "maximum": 1000000000000.0,
            "minimum": -1000000000000.0,
            "type": "number"
          },
          "maxItems": 9,
          "minItems": 9,
          "title": "Forward Matrix",
          "type": "array"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "matrix",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "forward_matrix"
      ],
      "title": "MatrixTransform",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Rect",
      "type": "object"
    },
    "ResizeTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "resize",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "title": "Pixel Centers",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "pixel_centers"
      ],
      "title": "ResizeTransform",
      "type": "object"
    },
    "TransformChain": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "crop": "#/$defs/CropTransform",
                "dense_warp": "#/$defs/DenseWarpTransform",
                "matrix": "#/$defs/MatrixTransform",
                "resize": "#/$defs/ResizeTransform"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MatrixTransform"
              },
              {
                "$ref": "#/$defs/DenseWarpTransform"
              },
              {
                "$ref": "#/$defs/CropTransform"
              },
              {
                "$ref": "#/$defs/ResizeTransform"
              }
            ]
          },
          "maxItems": 128,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps",
        "hash"
      ],
      "title": "TransformChain",
      "type": "object"
    },
    "ValidationPair": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "alignment": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "before": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "ignore": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pair_id": {
          "format": "uuid",
          "title": "Pair Id",
          "type": "string"
        },
        "person": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "session_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "session_id",
        "before",
        "after",
        "alignment"
      ],
      "title": "ValidationPair",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/style-validate-params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "holdout": {
      "items": {
        "$ref": "#/$defs/ValidationPair"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Holdout",
      "type": "array"
    },
    "samples_per_pair": {
      "default": 65536,
      "maximum": 65536,
      "minimum": 1024,
      "title": "Samples Per Pair",
      "type": "integer"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "style": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "threshold_profile_id": {
      "const": "style_validation_v1",
      "default": "style_validation_v1",
      "title": "Threshold Profile Id",
      "type": "string"
    },
    "training_session_ids": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Training Session Ids",
      "type": "array"
    }
  },
  "required": [
    "style",
    "holdout",
    "training_session_ids"
  ],
  "title": "StyleValidateParams",
  "type": "object"
}
