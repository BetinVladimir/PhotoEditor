{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SensorCrop": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 8,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "minimum": 8,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "SensorCrop",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/dust-params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "camera_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
      "title": "Camera Id",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 64,
      "minItems": 5,
      "title": "Frames",
      "type": "array"
    },
    "orientation": {
      "const": 1,
      "title": "Orientation",
      "type": "integer"
    },
    "raw_crop": {
      "$ref": "#/$defs/SensorCrop"
    },
    "recurrence": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0.8,
      "title": "Recurrence",
      "type": "number"
    },
    "sensor_height": {
      "maximum": 200000,
      "minimum": 8,
      "title": "Sensor Height",
      "type": "integer"
    },
    "sensor_width": {
      "maximum": 200000,
      "minimum": 8,
      "title": "Sensor Width",
      "type": "integer"
    }
  },
  "required": [
    "frames",
    "camera_id",
    "sensor_width",
    "sensor_height",
    "raw_crop",
    "orientation"
  ],
  "title": "DustParams",
  "type": "object"
}
