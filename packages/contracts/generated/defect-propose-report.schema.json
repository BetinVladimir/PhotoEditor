{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BeautyFace": {
      "additionalProperties": false,
      "properties": {
        "landmarks": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "manual": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manual_mode": {
          "default": false,
          "title": "Manual Mode",
          "type": "boolean"
        },
        "object_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "skin": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "landmarks"
      ],
      "title": "BeautyFace",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "orientation": {
          "const": 1,
          "title": "Orientation",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "space_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Space Id",
          "type": "string"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "orientation",
        "space_id",
        "source_sha256"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "CropTransform": {
      "additionalProperties": false,
      "properties": {
        "crop_rect": {
          "$ref": "#/$defs/Rect"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "crop",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "crop_rect"
      ],
      "title": "CropTransform",
      "type": "object"
    },
    "DefectProposalFaceReport": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "overlapping_candidates": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Overlapping Candidates",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "low_confidence",
                "face_too_small",
                "empty_skin",
                "subpixel_diameter",
                "degenerate_landmarks",
                "incomplete_face_roi"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "object_id",
        "reason",
        "threshold",
        "candidates",
        "overlapping_candidates"
      ],
      "title": "DefectProposalFaceReport",
      "type": "object"
    },
    "DefectProposeParams": {
      "additionalProperties": false,
      "properties": {
        "diameter_face_fraction": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Diameter Face Fraction",
          "type": "array"
        },
        "faces": {
          "items": {
            "$ref": "#/$defs/BeautyFace"
          },
          "maxItems": 64,
          "title": "Faces",
          "type": "array"
        },
        "image": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "permanent": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "image",
        "faces"
      ],
      "title": "DefectProposeParams",
      "type": "object"
    },
    "DenseWarpTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "inverse_field": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "dense_warp",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "inverse_field"
      ],
      "title": "DenseWarpTransform",
      "type": "object"
    },
    "MaskRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "model_lock_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Lock Id"
        },
        "object_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "selector": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$",
          "title": "Selector",
          "type": "string"
        },
        "transform_chain": {
          "$ref": "#/$defs/TransformChain"
        }
      },
      "required": [
        "artifact",
        "canvas",
        "transform_chain",
        "selector",
        "confidence",
        "model_lock_id",
        "protected"
      ],
      "title": "MaskRef",
      "type": "object"
    },
    "MatrixTransform": {
      "additionalProperties": false,
      "properties": {
        "forward_matrix": {
          "items": {
            "maximum": 1000000000000.0,
            "minimum": -1000000000000.0,
            "type": "number"
          },
          "maxItems": 9,
          "minItems": 9,
          "title": "Forward Matrix",
          "type": "array"
        },
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "matrix",
          "title": "Kind",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "forward_matrix"
      ],
      "title": "MatrixTransform",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Rect",
      "type": "object"
    },
    "ResizeTransform": {
      "additionalProperties": false,
      "properties": {
        "from_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "invertibility": {
          "enum": [
            "invertible",
            "partial",
            "noninvertible"
          ],
          "title": "Invertibility",
          "type": "string"
        },
        "kind": {
          "const": "resize",
          "title": "Kind",
          "type": "string"
        },
        "pixel_centers": {
          "const": "half_pixel",
          "title": "Pixel Centers",
          "type": "string"
        },
        "to_canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "valid_region": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "from_canvas",
        "to_canvas",
        "invertibility",
        "valid_region",
        "kind",
        "pixel_centers"
      ],
      "title": "ResizeTransform",
      "type": "object"
    },
    "TransformChain": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "crop": "#/$defs/CropTransform",
                "dense_warp": "#/$defs/DenseWarpTransform",
                "matrix": "#/$defs/MatrixTransform",
                "resize": "#/$defs/ResizeTransform"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MatrixTransform"
              },
              {
                "$ref": "#/$defs/DenseWarpTransform"
              },
              {
                "$ref": "#/$defs/CropTransform"
              },
              {
                "$ref": "#/$defs/ResizeTransform"
              }
            ]
          },
          "maxItems": 128,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps",
        "hash"
      ],
      "title": "TransformChain",
      "type": "object"
    }
  },
  "$id": "https://photoeditor.local/contracts/defect-propose-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "defect_dog_v1",
      "default": "defect_dog_v1",
      "title": "Algorithm",
      "type": "string"
    },
    "faces": {
      "items": {
        "$ref": "#/$defs/DefectProposalFaceReport"
      },
      "maxItems": 64,
      "title": "Faces",
      "type": "array"
    },
    "label_png": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "params": {
      "$ref": "#/$defs/DefectProposeParams"
    },
    "proposal": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "protection": {
      "$ref": "#/$defs/MaskRef"
    },
    "warnings": {
      "items": {
        "enum": [
          "no_faces",
          "face_skipped",
          "overlapping_candidates"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "params",
    "proposal",
    "protection",
    "label_png",
    "faces",
    "warnings"
  ],
  "title": "DefectProposeReport",
  "type": "object"
}
