{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framevela-portal",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./portal-worker.mjs",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "account_id": "434d7cf69d6175676c4fdcf9167a5033",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "framevela.com/*",
      "zone_id": "655180ec4477ee9712841a4b0f61a58e"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    }
  }
}
