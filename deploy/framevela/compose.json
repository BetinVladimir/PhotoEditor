{
  "name": "framevela",
  "services": {
    "postgres": {
      "image": "${POSTGRES_IMAGE:?required}",
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "environment": {
        "POSTGRES_DB": "photoeditor",
        "POSTGRES_USER": "photo_bootstrap",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?required}",
        "PGDATA": "/var/lib/postgresql/data/pgdata"
      },
      "command": [
        "postgres",
        "-c",
        "ssl=on",
        "-c",
        "ssl_cert_file=/run/tls/postgres.crt",
        "-c",
        "ssl_key_file=/run/tls/postgres.key",
        "-c",
        "max_connections=120",
        "-c",
        "shared_buffers=128MB"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/HC_Volume_107202006/postgres",
          "target": "/var/lib/postgresql/data",
          "bind": {
            "create_host_path": false
          }
        },
        "/srv/photoeditor/secrets/postgres/postgres.crt:/run/tls/postgres.crt:ro",
        "/srv/photoeditor/secrets/postgres/postgres.key:/run/tls/postgres.key:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U photo_bootstrap -d photoeditor"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      }
    },
    "rabbitmq": {
      "image": "${RABBITMQ_IMAGE:?required}",
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "environment": {
        "RABBITMQ_DEFAULT_USER": "framevela",
        "RABBITMQ_DEFAULT_PASS": "${RABBITMQ_DEFAULT_PASS:?required}",
        "RABBITMQ_DEFAULT_VHOST": "photo",
        "RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS": "+S 2:2"
      },
      "volumes": [
        "rabbit-data:/var/lib/rabbitmq"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "rabbitmq-diagnostics",
          "-q",
          "ping"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 10
      }
    },
    "minio": {
      "image": "${MINIO_IMAGE:?required}",
      "restart": "unless-stopped",
      "command": [
        "server",
        "/data",
        "--certs-dir",
        "/certs"
      ],
      "networks": [
        "backend"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${MINIO_ROOT_USER:?required}",
        "MINIO_ROOT_PASSWORD": "${MINIO_ROOT_PASSWORD:?required}",
        "MINIO_API_CORS_ALLOW_ORIGIN": "https://framevela.com,https://app.framevela.com"
      },
      "volumes": [
        "minio-data:/data",
        "/srv/photoeditor/secrets/minio/public.crt:/certs/public.crt:ro",
        "/srv/photoeditor/secrets/minio/private.key:/certs/private.key:ro",
        "/srv/photoeditor/secrets/minio/ca.crt:/certs/ca.crt:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "--cacert",
          "/certs/ca.crt",
          "https://minio:9000/minio/health/ready"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      }
    },
    "migrate": {
      "image": "${PHOTO_API_IMAGE:?required}",
      "restart": "no",
      "init": true,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "networks": [
        "backend"
      ],
      "environment": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://app.framevela.com",
        "PORTAL_ORIGIN": "https://framevela.com",
        "API_PUBLIC_ORIGIN": "https://api.framevela.com",
        "CAPTURE_ORIGIN": "https://app.framevela.com",
        "S3_ENDPOINT": "https://minio:9000",
        "S3_PUBLIC_ENDPOINT": "https://storage.framevela.com",
        "S3_BUCKET": "photo",
        "S3_ACCESS_KEY": "${S3_ACCESS_KEY:?required}",
        "S3_SECRET_KEY": "${S3_SECRET_KEY:?required}",
        "S3_REGION": "us-east-1",
        "S3_CORS_STRATEGY": "minio-server",
        "AMQP_URL": "${AMQP_URL:?required}",
        "PHOTO_ICC_ROOT": "/opt/photo/icc",
        "DATABASE_URL": "${MIGRATION_DATABASE_URL:?required}",
        "PHOTO_ROLE": "migrate",
        "SSL_CERT_FILE": "/run/photo/tls/trust-bundle.pem"
      },
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "profiles": [
        "bootstrap"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        },
        "rabbitmq": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        "/srv/photoeditor/secrets/trust-bundle.pem:/run/photo/tls/trust-bundle.pem:ro"
      ]
    },
    "bootstrap-storage": {
