        "DATABASE_URL": "${API_DATABASE_URL:?required}",
        "PHOTO_ROLE": "bootstrap-storage",
        "SSL_CERT_FILE": "/run/photo/tls/trust-bundle.pem"
      },
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m"
