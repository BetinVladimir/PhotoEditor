# syntax=docker/dockerfile:1.7
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=1GiB
RUN go mod download -json github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648 > /source.json
RUN cd /go/pkg/mod/github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648 && go build -p 2 -mod=readonly -trimpath -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z -X github.com/minio/minio/cmd.CommitID=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a' -o /minio-server . && cp LICENSE /LICENSE
FROM alpine:3.23
RUN apk add --no-cache ca-certificates curl && addgroup -S photo && adduser -S -G photo -u 10001 photo && mkdir /data && chown photo:photo /data
COPY --from=build /minio-server /usr/bin/minio
COPY --from=build /LICENSE /usr/share/licenses/photoeditor-minio/LICENSE
COPY --from=build /source.json /usr/share/licenses/photoeditor-minio/source.json
USER 10001:10001
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data"]
