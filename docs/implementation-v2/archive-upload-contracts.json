{
  "schemas": {
    "ArchiveUploadBegin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240,
          "pattern": "^[^\\\\/:\\u0000-\\u001f\\u007f-\\u009f]+\\.[zZ][iI][pP]$",
          "description": "NFC normalized; Unicode scalar length 5..240; server validates normalization."
        },
        "bytes": {
          "type": "integer",
          "minimum": 22,
          "maximum": 68719476736
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "filename",
        "bytes",
        "sha256"
      ]
    },
    "ArchiveUploadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "uploading",
            "completing",
            "verified"
          ]
        },
        "part_bytes": {
          "const": 16777216
        },
        "parts_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "upload_id",
        "state",
        "part_bytes",
        "parts_total",
        "request_sha256"
      ]
    },
    "ArchiveUploadPartsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "request_sha256",
        "parts"
      ]
    },
    "ArchiveUploadPartsResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "part_no": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "part_no",
              "url",
              "expires_at"
            ]
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "ArchiveUploadComplete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "part_no": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "etag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\r\\n\\u0000]+$"
              }
            },
            "required": [
              "part_no",
              "etag"
            ]
          },
          "description": "Exact contiguous ordered coverage 1..parts_total, no duplicate parts."
        }
      },
      "required": [
        "request_sha256",
        "parts"
      ]
    },
    "ArchiveUploadAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "accepted": {
          "const": true
        }
      },
      "required": [
        "upload_id",
        "accepted"
      ]
    },
    "ArchiveUploadAbort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "request_sha256"
      ]
    },
    "ArchiveUploadAbortAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "accepted": {
          "const": true
        },
        "cleanup_pending": {
          "type": "boolean"
        }
      },
      "required": [
        "upload_id",
        "accepted",
        "cleanup_pending"
      ]
    },
    "ArchiveUploadStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "reserved",
            "uploading",
            "completing",
            "verified",
            "aborting",
            "aborted",
            "failed"
          ]
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "ARCHIVE_INTEGRITY",
            "UPLOAD_ABORTED",
            "UPLOAD_EXPIRED"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "begin_recovery": {
          "type": "string",
          "enum": ["none", "reconciliation_required", "receipt_pending_bind", "resolved"]
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "upload_id",
        "state",
        "request_sha256",
        "expires_at",
        "ready",
        "begin_recovery"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ready": {
                "const": true
              }
            },
            "required": [
              "ready"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "verified"
              }
            },
            "required": [
              "artifact"
            ]
          },
          "else": {
            "not": {
              "required": [
                "artifact"
              ]
            }
          }
        }
      ]
    }
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/tenants/{t}/projects/{id}/interchange-archive-uploads",
      "request_schema": "ArchiveUploadBegin",
      "response_schema": "ArchiveUploadReceipt",
      "package": "V30",
      "handler": "BeginInterchangeArchiveUpload",
      "role": "editor",
      "success_status": 201
    },
    {
      "method": "POST",
      "path": "/api/v1/tenants/{t}/projects/{id}/interchange-archive-uploads/{upload}/parts",
      "request_schema": "ArchiveUploadPartsRequest",
      "response_schema": "ArchiveUploadPartsResponse",
      "package": "V30",
      "handler": "SignInterchangeArchiveParts",
      "role": "editor",
      "success_status": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/tenants/{t}/projects/{id}/interchange-archive-uploads/{upload}/complete",
      "request_schema": "ArchiveUploadComplete",
      "response_schema": "ArchiveUploadAccepted",
      "package": "V30",
      "handler": "CompleteInterchangeArchiveUpload",
      "role": "editor",
      "success_status": 202
    },
    {
      "method": "POST",
      "path": "/api/v1/tenants/{t}/projects/{id}/interchange-archive-uploads/{upload}/abort",
      "request_schema": "ArchiveUploadAbort",
      "response_schema": "ArchiveUploadAbortAccepted",
      "package": "V30",
      "handler": "AbortInterchangeArchiveUpload",
      "role": "editor",
      "success_status": 202
    },
    {
      "method": "POST",
      "path": "/api/v1/tenants/{t}/projects/{id}/interchange-archive-uploads/attempt-status",
      "request_schema": "ArchiveUploadBegin",
      "response_schema": "ArchiveUploadStatus",
      "package": "V30",
      "handler": "ReadInterchangeArchiveAttemptStatus",
      "role": "editor",
      "success_status": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/tenants/{t}/projects/{id}/interchange-archive-uploads/{upload}",
      "request_schema": null,
      "response_schema": "ArchiveUploadStatus",
      "package": "V30",
      "handler": "GetInterchangeArchiveUpload",
      "role": "editor",
      "success_status": 200
    }
  ]
}
