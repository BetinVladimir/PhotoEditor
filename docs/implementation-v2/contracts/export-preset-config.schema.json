{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"ExportPresetConfig",
 "type":"object","additionalProperties":false,
 "required":["format","icc_id","subsampling","alpha","metadata_policy","naming_template"],
 "properties":{
  "format":{"enum":["tiff","png","jpeg"]},
  "icc_id":{"enum":["srgb_v1","work_rec2020_gamma24_v1"]},
  "subsampling":{"const":"444"},"alpha":{"enum":["preserve","matte"]},
  "metadata_policy":{"enum":["strip","copyright","approved_exif"]},
  "naming_template":{"type":"string","minLength":1,"maxLength":200,"description":"Production validator additionally requires UTF-8 <=200 bytes, nonblank flat filename, no controls, and only original_name/name/sha8/ordinal brace tokens."},
  "quality":{"type":"integer","minimum":1,"maximum":100},
  "matte_rgb":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":0,"maximum":1}},
  "size":{"type":"object","additionalProperties":false,"required":["fit","allow_upscale"],"properties":{"fit":{"const":"contain"},"allow_upscale":{"type":"boolean"},"long_edge":{"type":"integer","minimum":1,"maximum":100000},"width":{"type":"integer","minimum":1,"maximum":100000},"height":{"type":"integer","minimum":1,"maximum":100000}},"oneOf":[{"required":["long_edge"],"not":{"anyOf":[{"required":["width"]},{"required":["height"]}]}},{"required":["width","height"],"not":{"required":["long_edge"]}}]},
  "watermark":{"type":"object","additionalProperties":false,"required":["asset_id","opacity","anchor","margin_x","margin_y"],"properties":{"asset_id":{"type":"string","format":"uuid","not":{"const":"00000000-0000-0000-0000-000000000000"}},"opacity":{"type":"number","minimum":0,"maximum":1},"anchor":{"enum":["top_left","top_right","bottom_left","bottom_right","center"]},"margin_x":{"type":"integer","minimum":0,"maximum":9007199254740991},"margin_y":{"type":"integer","minimum":0,"maximum":9007199254740991}}},
  "sharpen":{"type":"object","additionalProperties":false,"required":["radius","strength","threshold"],"properties":{"radius":{"type":"number","minimum":0.1,"maximum":5},"strength":{"type":"number","minimum":0,"maximum":1},"threshold":{"type":"number","minimum":0,"maximum":0.1}}}
 },
 "allOf":[
  {"if":{"properties":{"format":{"const":"jpeg"}}},"then":{"required":["quality"],"properties":{"alpha":{"const":"matte"}}},"else":{"not":{"required":["quality"]}}},
  {"if":{"properties":{"alpha":{"const":"matte"}}},"then":{"required":["matte_rgb"]},"else":{"not":{"required":["matte_rgb"]}}}
 ]
}
