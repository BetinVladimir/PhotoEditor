{
  "schema_version": 1,
  "stage": "legal_scaffold",
  "tables_comment": "schema_file groups tables into separate migrations; 02666=legal base, 02667=auth junction",
  "tables": [
    {
      "name": "legal_document_versions",
      "columns": [
        {
          "name": "document_id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        {
          "name": "document_key",
          "type": "text",
          "nullable": false
        },
        {
          "name": "locale",
          "type": "text",
          "nullable": false
        },
        {
          "name": "version",
          "type": "text",
          "nullable": false
        },
        {
          "name": "url",
          "type": "text",
          "nullable": false
        },
        {
          "name": "content_sha256",
          "type": "bytea",
          "nullable": false
        },
        {
          "name": "archive_ref",
          "type": "text",
          "nullable": false
        },
        {
          "name": "archive_version",
          "type": "text",
          "nullable": false
        },
        {
          "name": "published_at",
          "type": "timestamptz",
          "nullable": true
        },
        {
          "name": "effective_at",
          "type": "timestamptz",
          "nullable": true
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "default": "'draft'"
        },
        {
          "name": "reacceptance_required",
          "type": "boolean",
          "nullable": false,
          "default": "false"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()"
        }
      ],
      "primary_key": [
        "document_id"
      ],
      "constraints": [
        "UNIQUE(document_key,locale,version)",
        "CHECK(document_key IN ('terms','privacy','cookies','dpa','photoeditor_addendum'))",
        "CHECK(locale ~ '^[a-z]{2}(-[A-Z]{2})?$')",
        "CHECK(version ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}(\\.[0-9]+)?$')",
        "CHECK(url ~ '^https://legal\\.beeloy\\.org/')",
        "CHECK(state IN ('draft','active','retired'))",
        "CHECK(octet_length(content_sha256) = 32)",
        "CHECK(state != 'active' OR (published_at IS NOT NULL AND effective_at IS NOT NULL))",
        "CHECK(state != 'active' OR (archive_ref != '' AND archive_version != ''))"
      ],
      "indexes": [
        "CREATE INDEX ON photo.legal_document_versions(document_key,locale) WHERE state='active'"
      ],
      "append_only": false,
      "acl": {
        "photo_fn_owner": [
          "SELECT",
          "INSERT",
          "UPDATE"
        ]
      },
      "rls": "force_trusted_functions",
      "schema_file": "02666_billing_legal_schema.sql"
    },
