        },
        {
          "name": "retention_days",
          "type": "bigint",
          "nullable": true
        },
        {
          "name": "retention_trigger",
          "type": "text",
          "nullable": false
        },
        {
          "name": "backup_max_days",
          "type": "bigint",
          "nullable": true
        },
        {
          "name": "approval_ref",
          "type": "text",
          "nullable": true
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "default": "'draft'"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()"
        }
      ],
      "primary_key": [
        "policy_id"
      ],
      "constraints": [
        "UNIQUE(code,version)",
        "CHECK(version > 0)",
        "CHECK(state IN ('draft','approved','retired'))",
        "CHECK(state != 'approved' OR (retention_days IS NOT NULL AND retention_days > 0))",
        "CHECK(state != 'approved' OR (backup_max_days IS NOT NULL AND backup_max_days > 0))",
        "CHECK(state != 'approved' OR approval_ref IS NOT NULL)",
        "CHECK(retention_days IS NULL OR retention_days > 0)",
        "CHECK(backup_max_days IS NULL OR backup_max_days > 0)"
      ],
      "indexes": [
        "CREATE UNIQUE INDEX ON photo.privacy_retention_policies(code) WHERE state='approved'"
      ],
      "append_only": false,
      "acl": {
        "photo_fn_owner": [
          "SELECT",
          "INSERT",
          "UPDATE"
        ]
      },
      "rls": "force_trusted_functions",
      "schema_file": "02666_billing_legal_schema.sql"
    },
