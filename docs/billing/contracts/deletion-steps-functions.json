{
  "schema_version": 1,
  "scope": "deletion-steps",
  "functions": [
    {
      "signature": "account_enqueue_deletion_step(uuid,text,bigint,bytea)",
      "returns": "uuid",
      "owner": "photo_fn_owner",
      "execute_roles": [
        "photo_maintenance"
      ]
    },
    {
      "signature": "account_claim_deletion_step(uuid,bigint,bigint)",
