      "owner": "photo_fn_owner",
      "execute_roles": [
        "photo_maintenance"
      ]
    },
    {
      "signature": "account_record_deletion_step(uuid,uuid,uuid,text,bytea,text,bigint)",
      "returns": "text",
      "owner": "photo_fn_owner",
      "execute_roles": [
        "photo_maintenance"
      ]
    }
  ]
}
